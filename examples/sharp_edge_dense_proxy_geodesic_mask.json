{
  "version": "1.0",
  "name": "锐边高密度代理测地蒙版",
  "interface": {
    "inputs": [
      {"id":"geometry_in","name":"几何体","socket_type":"NodeSocketGeometry"},
      {"id":"sharp_vertex_group","name":"锐边顶点组","socket_type":"NodeSocketFloat","default":0.0},
      {"id":"sharp_threshold","name":"锐边阈值","socket_type":"NodeSocketFloat","default":0.5},
      {"id":"subdivision_level","name":"分析代理细分层级","socket_type":"NodeSocketInt","default":2},
      {"id":"relax_mask","name":"代理松弛遮罩","socket_type":"NodeSocketFloat","default":1.0},
      {"id":"relax_strength","name":"代理松弛强度","socket_type":"NodeSocketFloat","default":0.35},
      {"id":"relax_iterations","name":"代理松弛迭代次数","socket_type":"NodeSocketInt","default":2},
      {"id":"seed_distance","name":"锐边种子捕获距离","socket_type":"NodeSocketFloat","default":0.002},
      {"id":"spread_distance","name":"扩散距离","socket_type":"NodeSocketFloat","default":0.01},
      {"id":"attribute_name","name":"蒙版属性名称","socket_type":"NodeSocketString","default":"sharp_edge_dense_geodesic_mask"}
    ],
    "outputs": [
      {"id":"geometry_out","name":"几何体","socket_type":"NodeSocketGeometry"},
      {"id":"mask_out","name":"蒙版","socket_type":"NodeSocketFloat"}
    ]
  },
  "nodes": [
    {"id":"source_edge_vertices","type":"GeometryNodeInputMeshEdgeVertices","label":"读取原模型边端点","location":[-1500,650]},
    {"id":"source_weight_a","type":"GeometryNodeFieldAtIndex","label":"原边端点一权重","location":[-1250,750],"properties":{"data_type":"FLOAT","domain":"POINT"}},
    {"id":"source_weight_b","type":"GeometryNodeFieldAtIndex","label":"原边端点二权重","location":[-1250,500],"properties":{"data_type":"FLOAT","domain":"POINT"}},
    {"id":"source_compare_a","type":"FunctionNodeCompare","label":"原边端点一已标记","location":[-1000,750],"properties":{"data_type":"FLOAT","operation":"GREATER_THAN"}},
    {"id":"source_compare_b","type":"FunctionNodeCompare","label":"原边端点二已标记","location":[-1000,500],"properties":{"data_type":"FLOAT","operation":"GREATER_THAN"}},
    {"id":"source_both","type":"FunctionNodeBooleanMath","label":"提取锐边条件","location":[-750,650],"properties":{"operation":"AND"}},
    {"id":"source_edges","type":"GeometryNodeSeparateGeometry","label":"原表面连续锐边","location":[-500,700],"properties":{"domain":"EDGE"}},

    {"id":"subdivide","type":"GeometryNodeSubdivideMesh","label":"建立高密度分析代理","location":[-1450,100]},
    {"id":"triangulate","type":"GeometryNodeTriangulate","label":"增加测地传播方向","location":[-1200,100]},
    {"id":"analysis_position","type":"GeometryNodeInputPosition","label":"分析代理位置","location":[-1200,-250]},
    {"id":"blur_position","type":"GeometryNodeBlurAttribute","label":"分析代理位置松弛","location":[-950,-100],"properties":{"data_type":"FLOAT_VECTOR"}},
    {"id":"relax_factor","type":"ShaderNodeMath","label":"松弛遮罩 × 强度","location":[-950,-400],"properties":{"operation":"MULTIPLY"}},
    {"id":"clamp_relax","type":"ShaderNodeClamp","label":"限制松弛权重 0-1","location":[-700,-400]},
    {"id":"inverse_relax","type":"ShaderNodeMath","label":"保留原位置权重","location":[-450,-500],"inputs":{"0":1.0},"properties":{"operation":"SUBTRACT"}},
    {"id":"analysis_original_scale","type":"ShaderNodeVectorMath","label":"分析原位置加权","location":[-200,-450],"properties":{"operation":"SCALE"}},
    {"id":"analysis_relaxed_scale","type":"ShaderNodeVectorMath","label":"分析松弛位置加权","location":[-200,-100],"properties":{"operation":"SCALE"}},
    {"id":"analysis_candidate","type":"ShaderNodeVectorMath","label":"分析候选位置","location":[50,-250],"properties":{"operation":"ADD"}},
    {"id":"project_analysis","type":"GeometryNodeSampleNearestSurface","label":"投射回原始代理表面","location":[300,-50],"properties":{"data_type":"FLOAT_VECTOR"}},
    {"id":"set_analysis_position","type":"GeometryNodeSetPosition","label":"写入分析代理位置","location":[550,100]},

    {"id":"seed_proximity","type":"GeometryNodeProximity","label":"分析点到原锐边距离","location":[50,650],"properties":{"target_element":"EDGES"}},
    {"id":"seed_compare","type":"FunctionNodeCompare","label":"捕获锐边种子顶点","location":[300,600],"properties":{"data_type":"FLOAT","operation":"LESS_THAN"}},
    {"id":"analysis_edge_vertices","type":"GeometryNodeInputMeshEdgeVertices","label":"读取分析代理边长","location":[550,450]},
    {"id":"analysis_edge_length","type":"ShaderNodeVectorMath","label":"分析代理真实边长","location":[800,450],"properties":{"operation":"DISTANCE"}},
    {"id":"shortest_paths","type":"GeometryNodeInputShortestEdgePaths","label":"高密度代理测地距离","location":[1050,550]},
    {"id":"safe_spread","type":"ShaderNodeMath","label":"限制最小扩散距离","location":[1050,250],"inputs":{"1":0.000001},"properties":{"operation":"MAXIMUM"}},
    {"id":"analysis_mask","type":"ShaderNodeMapRange","label":"测地距离转平滑蒙版","location":[1300,500],"inputs":{"From Min":0.0,"To Min":1.0,"To Max":0.0},"properties":{"data_type":"FLOAT","interpolation_type":"SMOOTHERSTEP","clamp":true}},
    {"id":"sample_back","type":"GeometryNodeSampleNearestSurface","label":"蒙版采样回原代理模型","location":[1550,500],"properties":{"data_type":"FLOAT"}},
    {"id":"store_mask","type":"GeometryNodeStoreNamedAttribute","label":"存储高密度代理蒙版","location":[1800,550],"properties":{"data_type":"FLOAT","domain":"POINT"}}
  ],
  "links": [
    {"from_node":"source_edge_vertices","from_socket":"Vertex Index 1","to_node":"source_weight_a","to_socket":"Index"},
    {"from_node":"source_edge_vertices","from_socket":"Vertex Index 2","to_node":"source_weight_b","to_socket":"Index"},
    {"from_node":"__group_input__","from_socket":"锐边顶点组","to_node":"source_weight_a","to_socket":"Value"},
    {"from_node":"__group_input__","from_socket":"锐边顶点组","to_node":"source_weight_b","to_socket":"Value"},
    {"from_node":"source_weight_a","from_socket":"Value","to_node":"source_compare_a","to_socket":"A"},
    {"from_node":"source_weight_b","from_socket":"Value","to_node":"source_compare_b","to_socket":"A"},
    {"from_node":"__group_input__","from_socket":"锐边阈值","to_node":"source_compare_a","to_socket":"B"},
    {"from_node":"__group_input__","from_socket":"锐边阈值","to_node":"source_compare_b","to_socket":"B"},
    {"from_node":"source_compare_a","from_socket":"Result","to_node":"source_both","to_socket":0},
    {"from_node":"source_compare_b","from_socket":"Result","to_node":"source_both","to_socket":1},
    {"from_node":"__group_input__","from_socket":"几何体","to_node":"source_edges","to_socket":"Geometry"},
    {"from_node":"source_both","from_socket":"Boolean","to_node":"source_edges","to_socket":"Selection"},

    {"from_node":"__group_input__","from_socket":"几何体","to_node":"subdivide","to_socket":"Mesh"},
    {"from_node":"__group_input__","from_socket":"分析代理细分层级","to_node":"subdivide","to_socket":"Level"},
    {"from_node":"subdivide","from_socket":"Mesh","to_node":"triangulate","to_socket":"Mesh"},
    {"from_node":"analysis_position","from_socket":"Position","to_node":"blur_position","to_socket":"Value"},
    {"from_node":"__group_input__","from_socket":"代理松弛迭代次数","to_node":"blur_position","to_socket":"Iterations"},
    {"from_node":"__group_input__","from_socket":"代理松弛遮罩","to_node":"relax_factor","to_socket":0},
    {"from_node":"__group_input__","from_socket":"代理松弛强度","to_node":"relax_factor","to_socket":1},
    {"from_node":"relax_factor","from_socket":"Value","to_node":"clamp_relax","to_socket":"Value"},
    {"from_node":"clamp_relax","from_socket":"Result","to_node":"inverse_relax","to_socket":1},
    {"from_node":"analysis_position","from_socket":"Position","to_node":"analysis_original_scale","to_socket":0},
    {"from_node":"inverse_relax","from_socket":"Value","to_node":"analysis_original_scale","to_socket":3},
    {"from_node":"blur_position","from_socket":"Value","to_node":"analysis_relaxed_scale","to_socket":0},
    {"from_node":"clamp_relax","from_socket":"Result","to_node":"analysis_relaxed_scale","to_socket":3},
    {"from_node":"analysis_original_scale","from_socket":"Vector","to_node":"analysis_candidate","to_socket":0},
    {"from_node":"analysis_relaxed_scale","from_socket":"Vector","to_node":"analysis_candidate","to_socket":1},
    {"from_node":"__group_input__","from_socket":"几何体","to_node":"project_analysis","to_socket":"Mesh"},
    {"from_node":"analysis_position","from_socket":"Position","to_node":"project_analysis","to_socket":"Value"},
    {"from_node":"analysis_candidate","from_socket":"Vector","to_node":"project_analysis","to_socket":"Sample Position"},
    {"from_node":"triangulate","from_socket":"Mesh","to_node":"set_analysis_position","to_socket":"Geometry"},
    {"from_node":"project_analysis","from_socket":"Value","to_node":"set_analysis_position","to_socket":"Position"},

    {"from_node":"source_edges","from_socket":"Selection","to_node":"seed_proximity","to_socket":"Geometry"},
    {"from_node":"analysis_position","from_socket":"Position","to_node":"seed_proximity","to_socket":"Sample Position"},
    {"from_node":"seed_proximity","from_socket":"Distance","to_node":"seed_compare","to_socket":"A"},
    {"from_node":"__group_input__","from_socket":"锐边种子捕获距离","to_node":"seed_compare","to_socket":"B"},
    {"from_node":"seed_compare","from_socket":"Result","to_node":"shortest_paths","to_socket":"End Vertex"},
    {"from_node":"analysis_edge_vertices","from_socket":"Position 1","to_node":"analysis_edge_length","to_socket":0},
    {"from_node":"analysis_edge_vertices","from_socket":"Position 2","to_node":"analysis_edge_length","to_socket":1},
    {"from_node":"analysis_edge_length","from_socket":"Value","to_node":"shortest_paths","to_socket":"Edge Cost"},
    {"from_node":"shortest_paths","from_socket":"Total Cost","to_node":"analysis_mask","to_socket":"Value"},
    {"from_node":"__group_input__","from_socket":"扩散距离","to_node":"safe_spread","to_socket":0},
    {"from_node":"safe_spread","from_socket":"Value","to_node":"analysis_mask","to_socket":"From Max"},

    {"from_node":"set_analysis_position","from_socket":"Geometry","to_node":"sample_back","to_socket":"Mesh"},
    {"from_node":"analysis_mask","from_socket":"Result","to_node":"sample_back","to_socket":"Value"},
    {"from_node":"analysis_position","from_socket":"Position","to_node":"sample_back","to_socket":"Sample Position"},
    {"from_node":"__group_input__","from_socket":"几何体","to_node":"store_mask","to_socket":"Geometry"},
    {"from_node":"__group_input__","from_socket":"蒙版属性名称","to_node":"store_mask","to_socket":"Name"},
    {"from_node":"sample_back","from_socket":"Value","to_node":"store_mask","to_socket":"Value"},
    {"from_node":"store_mask","from_socket":"Geometry","to_node":"__group_output__","to_socket":"几何体"},
    {"from_node":"sample_back","from_socket":"Value","to_node":"__group_output__","to_socket":"蒙版"}
  ]
}
