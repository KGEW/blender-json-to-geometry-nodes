{
  "version": "1.0",
  "name": "Normal Field Uniform Surface Mask v2",
  "interface": {
    "inputs": [
      {"id": "geometry_in", "name": "Geometry", "socket_type": "NodeSocketGeometry"},
      {"id": "voxel_size", "name": "Voxel Size", "socket_type": "NodeSocketFloat", "default": 0.05},
      {"id": "sample_radius", "name": "Sample Radius", "socket_type": "NodeSocketFloat", "default": 0.05},
      {"id": "low_variation", "name": "Low Variation", "socket_type": "NodeSocketFloat", "default": 0.02},
      {"id": "high_variation", "name": "High Variation", "socket_type": "NodeSocketFloat", "default": 0.35}
    ],
    "outputs": [
      {"id": "geometry_out", "name": "Geometry", "socket_type": "NodeSocketGeometry"},
      {"id": "mask", "name": "Mask", "socket_type": "NodeSocketFloat"}
    ]
  },
  "nodes": [
    {"id":"mesh_to_sdf","type":"GeometryNodeMeshToSDFGrid","label":"Uniform Analysis SDF","location":[-1500,300]},
    {"id":"grid_to_mesh","type":"GeometryNodeGridToMesh","label":"Uniform Proxy Surface","location":[-1250,300],"inputs":{"Threshold":0.0,"Adaptivity":0.0}},
    {"id":"normal_source","type":"GeometryNodeInputNormal","label":"Original Smooth Normal","location":[-1500,-350]},
    {"id":"position_proxy","type":"GeometryNodeInputPosition","label":"Proxy Position","location":[-1250,-350]},
    {"id":"position_original","type":"GeometryNodeInputPosition","label":"Original Position","location":[-400,-750]},
    {"id":"sample_center","type":"GeometryNodeSampleNearestSurface","label":"Sample Original Normal At Proxy","location":[-1000,350],"properties":{"data_type":"FLOAT_VECTOR"}},
    {"id":"separate_z","type":"ShaderNodeSeparateXYZ","label":"Normal Z","location":[-800,700]},
    {"id":"abs_z","type":"ShaderNodeMath","label":"Absolute Normal Z","location":[-600,700],"properties":{"operation":"ABSOLUTE"}},
    {"id":"less_than","type":"ShaderNodeMath","label":"Choose Stable Axis","location":[-400,700],"inputs":{"1":0.9},"properties":{"operation":"LESS_THAN"}},
    {"id":"axis_switch","type":"GeometryNodeSwitch","label":"Stable Reference Axis","location":[-200,700],"inputs":{"False":[1.0,0.0,0.0],"True":[0.0,0.0,1.0]},"properties":{"input_type":"VECTOR"}},
    {"id":"tangent_cross","type":"ShaderNodeVectorMath","label":"Normal Cross Axis","location":[0,700],"properties":{"operation":"CROSS_PRODUCT"}},
    {"id":"tangent_normalize","type":"ShaderNodeVectorMath","label":"Tangent T","location":[200,700],"properties":{"operation":"NORMALIZE"}},
    {"id":"bitangent_cross","type":"ShaderNodeVectorMath","label":"Normal Cross Tangent","location":[400,700],"properties":{"operation":"CROSS_PRODUCT"}},
    {"id":"bitangent_normalize","type":"ShaderNodeVectorMath","label":"Bitangent B","location":[600,700],"properties":{"operation":"NORMALIZE"}},
    {"id":"radius_negative","type":"ShaderNodeMath","label":"Negative Radius","location":[-200,500],"inputs":{"1":-1.0},"properties":{"operation":"MULTIPLY"}},
