    {"id":"position_t_pos","type":"ShaderNodeVectorMath","label":"P + T","location":[800,250],"properties":{"operation":"ADD"}},
    {"id":"position_t_neg","type":"ShaderNodeVectorMath","label":"P - T","location":[1000,250],"properties":{"operation":"ADD"}},
    {"id":"position_b_pos","type":"ShaderNodeVectorMath","label":"P + B","location":[1200,250],"properties":{"operation":"ADD"}},
    {"id":"position_b_neg","type":"ShaderNodeVectorMath","label":"P - B","location":[1400,250],"properties":{"operation":"ADD"}},
    {"id":"sample_t_pos","type":"GeometryNodeSampleNearestSurface","label":"Sample +T","location":[800,0],"properties":{"data_type":"FLOAT_VECTOR"}},
    {"id":"sample_t_neg","type":"GeometryNodeSampleNearestSurface","label":"Sample -T","location":[1000,0],"properties":{"data_type":"FLOAT_VECTOR"}},
    {"id":"sample_b_pos","type":"GeometryNodeSampleNearestSurface","label":"Sample +B","location":[1200,0],"properties":{"data_type":"FLOAT_VECTOR"}},
    {"id":"sample_b_neg","type":"GeometryNodeSampleNearestSurface","label":"Sample -B","location":[1400,0],"properties":{"data_type":"FLOAT_VECTOR"}},
    {"id":"dist_t_pos","type":"ShaderNodeVectorMath","label":"Normal Delta +T","location":[800,-250],"properties":{"operation":"DISTANCE"}},
    {"id":"dist_t_neg","type":"ShaderNodeVectorMath","label":"Normal Delta -T","location":[1000,-250],"properties":{"operation":"DISTANCE"}},
    {"id":"dist_b_pos","type":"ShaderNodeVectorMath","label":"Normal Delta +B","location":[1200,-250],"properties":{"operation":"DISTANCE"}},
    {"id":"dist_b_neg","type":"ShaderNodeVectorMath","label":"Normal Delta -B","location":[1400,-250],"properties":{"operation":"DISTANCE"}},
    {"id":"sum_t","type":"ShaderNodeMath","label":"T Pair Mean Sum","location":[1100,-450],"properties":{"operation":"ADD"}},
    {"id":"sum_b","type":"ShaderNodeMath","label":"B Pair Mean Sum","location":[1350,-450],"properties":{"operation":"ADD"}},
    {"id":"sum_all","type":"ShaderNodeMath","label":"Four Direction Sum","location":[1600,-400],"properties":{"operation":"ADD"}},
    {"id":"average","type":"ShaderNodeMath","label":"Average Normal Change","location":[1800,-400],"inputs":{"1":0.25},"properties":{"operation":"MULTIPLY"}},
    {"id":"smooth_mask","type":"ShaderNodeMapRange","label":"0-1 Variation Mask","location":[2000,-400],"inputs":{"To Min":0.0,"To Max":1.0},"properties":{"interpolation_type":"SMOOTHERSTEP","clamp":true}},
    {"id":"proxy_store","type":"GeometryNodeStoreNamedAttribute","label":"Store Mask On Uniform Proxy","location":[2200,250],"inputs":{"Name":"__normal_turn_mask_proxy"},"properties":{"data_type":"FLOAT","domain":"POINT"}},
    {"id":"proxy_mask_attribute","type":"GeometryNodeInputNamedAttribute","label":"Read Proxy Mask","location":[2200,-100],"inputs":{"Name":"__normal_turn_mask_proxy"},"properties":{"data_type":"FLOAT"}},
    {"id":"projected_mask","type":"GeometryNodeSampleNearestSurface","label":"Project Mask To Original","location":[2400,-250],"properties":{"data_type":"FLOAT"}},
    {"id":"store_mask","type":"GeometryNodeStoreNamedAttribute","label":"Store normal_turn_mask","location":[2400,100],"inputs":{"Name":"normal_turn_mask"},"properties":{"data_type":"FLOAT","domain":"POINT"}}
