    {"id":"tangent_neg_scale","type":"ShaderNodeVectorMath","label":"-T Radius","location":[600,500],"properties":{"operation":"SCALE"}},
    {"id":"bitangent_pos_scale","type":"ShaderNodeVectorMath","label":"+B Radius","location":[800,500],"properties":{"operation":"SCALE"}},
